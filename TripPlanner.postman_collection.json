{
  "info": {
    "_postman_id": "tripplanner-complete-suite-v1",
    "name": "TripPlanner API",
    "description": "Postman Collection for TripPlanner - Case Study 71. Covers All Phases 1 to 6.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "tripId", "value": "", "type": "string" },
    { "key": "itineraryId", "value": "", "type": "string" },
    { "key": "destinationId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "0. System Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          }
        }
      ]
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex@example.com\",\n  \"password\": \"userPassword123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tripplanner.com\",\n  \"password\": \"adminPassword123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Update FCM Token",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcmToken\": \"sample_fcm_token_123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/fcm-token", "host": ["{{baseUrl}}"], "path": ["api", "auth", "fcm-token"] }
          }
        }
      ]
    },
    {
      "name": "2. Trips",
      "item": [
        {
          "name": "Create Trip",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Trip to Tokyo\",\n  \"destination\": \"Tokyo\",\n  \"startDate\": \"2026-08-01\",\n  \"endDate\": \"2026-08-08\",\n  \"budget\": 180000,\n  \"currency\": \"INR\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/trips", "host": ["{{baseUrl}}"], "path": ["api", "trips"] }
          }
        },
        {
          "name": "Get All Trips",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/trips?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "trips"] }
          }
        },
        {
          "name": "Get Trip Offline Bundle",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/trips/{{tripId}}/offline", "host": ["{{baseUrl}}"], "path": ["api", "trips", "{{tripId}}", "offline"] }
          }
        }
      ]
    },
    {
      "name": "3. Bookings & Expenses",
      "item": [
        {
          "name": "Search Flights",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/flights?from=DEL&to=PAR&date=2026-08-01", "host": ["{{baseUrl}}"], "path": ["api", "flights"] }
          }
        },
        {
          "name": "Search Hotels",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/hotels?destination=Paris&checkIn=2026-08-01&checkOut=2026-08-05", "host": ["{{baseUrl}}"], "path": ["api", "hotels"] }
          }
        },
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tripId\": \"{{tripId}}\",\n  \"type\": \"flight\",\n  \"totalAmount\": 15000,\n  \"details\": {\n    \"airline\": \"Air France\",\n    \"flightNumber\": \"AF-101\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
          }
        },
        {
          "name": "Get Trip Expenses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/expenses/trip/{{tripId}}", "host": ["{{baseUrl}}"], "path": ["api", "expenses", "trip", "{{tripId}}"] }
          }
        }
      ]
    },
    {
      "name": "4. Destinations & Weather",
      "item": [
        {
          "name": "Get Destinations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/destinations", "host": ["{{baseUrl}}"], "path": ["api", "admin", "destinations"] }
          }
        },
        {
          "name": "Get Weather",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/weather?city=Paris", "host": ["{{baseUrl}}"], "path": ["api", "weather"] }
          }
        }
      ]
    },
    {
      "name": "5. Notifications",
      "item": [
        {
          "name": "Send Notification (Self)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Pack Luggage\",\n  \"body\": \"Flight leaves in 24 hours!\",\n  \"type\": \"reminder\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/notifications/send", "host": ["{{baseUrl}}"], "path": ["api", "notifications", "send"] }
          }
        },
        {
          "name": "Get Notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/notifications", "host": ["{{baseUrl}}"], "path": ["api", "notifications"] }
          }
        }
      ]
    }
  ]
}
